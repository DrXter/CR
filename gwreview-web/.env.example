# Choose the first admin password (otherwise one is generated and printed once in the log)
GWR_ADMIN_PASSWORD=
# Set to 1 once the app is served over HTTPS (it should be)
GWR_COOKIE_SECURE=1
# Optional: needed only if you run a headed browser locally for FIDO2 keys
# GWR_HEADED=1
# Test-lab only. Never set these against Guidewire Cloud:
# GWR_ALLOW_HTTP=1
# GWR_ALLOW_PRIVATE_TARGETS=1
